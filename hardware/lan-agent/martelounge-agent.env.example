# Martelounge LAN agent config. Copy to `martelounge-agent.env` and fill in.
# (install.sh does this for you and reads it as the systemd EnvironmentFile.)

# Your Supabase project URL (the gateway base). No trailing slash.
GATEWAY_URL=https://rvlkimzqzwizcivkxtnd.supabase.co

# API key from the admin panel: პარამეტრები → API გასაღებები (scope: 🔌 device:hardware).
API_KEY=mk_xxxxxxxxxxxxxxxxxxxxxxxx

# How often to reconcile, in seconds.
POLL_INTERVAL=5

# Per-HTTP-call timeout, in seconds.
HTTP_TIMEOUT=4

# true = simulate relays (no physical actuation). Use to validate the loop first.
DRY_RUN=false

# Where the agent persists last-applied relay state (fail-safe across restarts).
# STATE_FILE=/var/lib/martelounge-agent/agent-state.json
