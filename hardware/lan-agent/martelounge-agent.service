[Unit]
Description=Martelounge LAN hardware agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install.sh fills these in for your box:
WorkingDirectory=/opt/martelounge-agent
EnvironmentFile=/opt/martelounge-agent/martelounge-agent.env
ExecStart=/opt/martelounge-agent/.venv/bin/python /opt/martelounge-agent/agent.py
Restart=always
RestartSec=5
# Don't let a crash loop hammer the gateway:
StartLimitIntervalSec=60
StartLimitBurst=10
User=martelounge
Group=martelounge

[Install]
WantedBy=multi-user.target
